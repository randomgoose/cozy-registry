# Required in production (signs OAuth codes + access tokens)
OAUTH_CODE_SIGNING_SECRET=

# Optional — match Figma connector Advanced settings (same as main Cozy Registry):
# OAUTH_CLIENT_ID=cozy-figma-make
# OAUTH_CLIENT_SECRET=
# Aliases (read if OAUTH_CLIENT_* unset):
# OAUTH_FIGMA_CLIENT_ID=
# OAUTH_FIGMA_CLIENT_SECRET=

# Optional — debug: POST to /api/mcp-inspect with header X-MCP-Inspect: <this value>
# to get JSON { httpStatus, bodyRaw, bodyJson } (Vercel request UI does not show bodies).
# MCP_INSPECT_SECRET=
