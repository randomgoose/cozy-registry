# Hoisted node_modules so Serverless (Vercel) can resolve packages via
# createRequire(<app>/package.json) the same way as local dev. Isolated pnpm
# layouts often break require.resolve for prebundle/preview dependency code.
node-linker=hoisted
# Avoid interactive prompt when switching linker (CI / Vercel / fresh clones).
confirm-modules-purge=false
