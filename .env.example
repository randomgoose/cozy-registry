DATABASE_URL="postgresql://user:password@localhost:5432/registry"
# Supabase: 用 pooler (6543) 给应用，用 Session/直连 (5432) 给 db:push
# DATABASE_DIRECT_URL="postgres://...@db.xxx.supabase.co:5432/postgres"
BETTER_AUTH_SECRET="your-32-char-secret-minimum"
BETTER_AUTH_URL="http://localhost:3000"

# 面向浏览器的公开 URL。NEXT_PUBLIC_* 在 Next 构建时写入产物，改 Vercel 环境变量后需重新部署。
# 仅服务端逻辑也可用 APP_URL（运行时读取）。MCP / OAuth 元数据会优先用请求的 Host（自定义域访问即显示自定义域）。
# NEXT_PUBLIC_APP_URL="https://your-domain.com"
# APP_URL="https://your-domain.com"

# Resend (organization / team invitation emails) — https://resend.com/api-keys
# RESEND_API_KEY="re_..."
# RESEND_FROM="Cozy Registry <onboarding@resend.dev>"

# Supabase Storage（thumbnail worker）
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="registry-thumbnails"

# Object storage provider (preview artifacts + thumbnails)
# OBJECT_STORAGE_PROVIDER="supabase" # or "s3" / "r2"
#
# S3-compatible (AWS S3 / Cloudflare R2 / MinIO)
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT="" # e.g. https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"
# S3_PUBLIC_BASE_URL="" # optional CDN/custom domain base, e.g. https://cdn.example.com

# Thumbnail worker（本地调试可选）
# 若本地 Playwright 无法自动找到浏览器，可显式指定：
# THUMBNAIL_BROWSER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Figma OAuth (https://www.figma.com/developers/apps)
FIGMA_CLIENT_ID=""
FIGMA_CLIENT_SECRET=""

# Figma Make MCP OAuth（可选）：若在 Figma 侧预注册了 client_id/secret，在此填写以便 token 交换时校验
# OAUTH_FIGMA_CLIENT_ID="cozy-figma-make"
# OAUTH_FIGMA_CLIENT_SECRET=""
# Cursor MCP OAuth（可选）：可按 Static OAuth（secret）或 public client（none）配置
# OAUTH_CURSOR_CLIENT_ID="cozy-cursor"
# OAUTH_CURSOR_CLIENT_SECRET=""
# OAUTH_CURSOR_REDIRECT_URIS="cursor://anysphere.cursor-mcp/oauth/callback"
# OAUTH_CURSOR_REDIRECT_URI_PREFIXES="cursor://anysphere.cursor-mcp/oauth/"
# OAUTH_CURSOR_TOKEN_ENDPOINT_AUTH_METHOD="client_secret_post"
# 可选：与 access token 解耦的 refresh_token HMAC 密钥；不设则复用 BETTER_AUTH_SECRET
# OAUTH_REFRESH_TOKEN_SECRET=""
