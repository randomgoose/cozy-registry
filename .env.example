# ---------------------------------------------------------------------------
# Required: local development minimum
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://user:password@localhost:5432/registry"

# Supabase: use pooler (6543) for the app, and direct/session mode (5432) for
# schema push / migrations when needed.
# DATABASE_DIRECT_URL="postgres://...@db.xxx.supabase.co:5432/postgres"

BETTER_AUTH_SECRET="your-32-char-secret-minimum"
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Recommended: local host URLs
# ---------------------------------------------------------------------------

# Web host public origin.
APP_URL="http://localhost:5173"
COZY_WEB_BASE_URL="http://localhost:5173"

# Platform host public origin.
COZY_PLATFORM_BASE_URL="http://localhost:3000"

# Browser-side platform base URL for apps/web.
VITE_COZY_PLATFORM_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional: email / invitations
# ---------------------------------------------------------------------------

# Resend (organization / team invitation emails) — https://resend.com/api-keys
# RESEND_API_KEY="re_..."
# RESEND_FROM="Cozy Registry <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Optional: Supabase Storage / thumbnail worker
# ---------------------------------------------------------------------------

# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="registry-thumbnails"

# Local thumbnail debugging only. Set this if Playwright cannot find a browser.
# THUMBNAIL_BROWSER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# ---------------------------------------------------------------------------
# Optional: social sign-in
# ---------------------------------------------------------------------------

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Figma OAuth (https://www.figma.com/developers/apps)
FIGMA_CLIENT_ID=""
FIGMA_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Optional: MCP OAuth clients
# ---------------------------------------------------------------------------

# Figma Make MCP OAuth
# OAUTH_FIGMA_CLIENT_ID="cozy-figma-make"
# OAUTH_FIGMA_CLIENT_SECRET=""

# Cursor MCP OAuth
# OAUTH_CURSOR_CLIENT_ID="cozy-cursor"
# OAUTH_CURSOR_CLIENT_SECRET=""
# OAUTH_CURSOR_REDIRECT_URIS="cursor://anysphere.cursor-mcp/oauth/callback"
# OAUTH_CURSOR_REDIRECT_URI_PREFIXES="cursor://anysphere.cursor-mcp/oauth/"
# OAUTH_CURSOR_TOKEN_ENDPOINT_AUTH_METHOD="client_secret_post"

# Optional: separate refresh token HMAC secret. Defaults to BETTER_AUTH_SECRET.
# OAUTH_REFRESH_TOKEN_SECRET=""

# ---------------------------------------------------------------------------
# Legacy compatibility fallbacks
# ---------------------------------------------------------------------------

# Avoid using these for new setup. They are still read in a few compatibility
# paths, but the preferred variables are APP_URL / COZY_WEB_BASE_URL and
# COZY_PLATFORM_BASE_URL.
#
# NEXT_PUBLIC_APP_URL="http://localhost:5173"
