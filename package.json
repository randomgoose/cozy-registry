{
  "name": "cozy-registry",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "with-env:dev": "tsx bin/run-with-env.ts dev",
    "with-env:prod": "tsx bin/run-with-env.ts prod",
    "cozy": "tsx bin/cozy-registry.ts",
    "cozy-registry": "tsx bin/cozy-registry.ts",
    "cozy-dev": "tsx bin/cozy-dev.ts",
    "cozy-web": "tsx bin/cozy-web.ts",
    "cozy-platform": "tsx bin/cozy-platform.ts",
    "cozy-mcp": "tsx bin/cozy-mcp-stdio.ts",
    "turbo:dev": "turbo run dev --parallel",
    "turbo:build": "turbo run build",
    "turbo:typecheck": "turbo run typecheck",
    "turbo:lint": "turbo run lint",
    "turbo:test": "turbo run test",
    "web:dev": "pnpm --filter @cozy/web dev",
    "web:build": "pnpm --filter @cozy/web build",
    "web:preview": "pnpm --filter @cozy/web preview",
    "web:typecheck": "pnpm --filter @cozy/web typecheck",
    "cozy-thumbnail-debug": "tsx bin/cozy-thumbnail-debug.ts",
    "cozy-thumbnail-requeue-all": "tsx bin/cozy-thumbnail-requeue-all.ts",
    "cozy-thumbnail-worker": "tsx bin/cozy-thumbnail-worker.ts",
    "dev": "tsx bin/cozy-dev.ts",
    "dev:web": "tsx bin/cozy-web.ts",
    "dev:platform": "tsx bin/cozy-platform.ts",
    "build": "pnpm turbo:build && pnpm exec tsc --noEmit",
    "start": "pnpm web:preview",
    "lint": "eslint",
    "test": "vitest run",
    "test:email": "tsx bin/test-resend-email.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:dev": "tsx bin/run-with-env.ts dev drizzle-kit push",
    "db:push:prod": "tsx bin/run-with-env.ts prod drizzle-kit push",
    "db:push:dev:pooler": "tsx bin/run-with-env.ts dev FORCE_DATABASE_URL=1 drizzle-kit push",
    "db:push:prod:pooler": "tsx bin/run-with-env.ts prod FORCE_DATABASE_URL=1 drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx packages/db/scripts/seed.ts",
    "db:seed:dev": "tsx bin/run-with-env.ts dev tsx packages/db/scripts/seed.ts",
    "db:seed:prod": "tsx bin/run-with-env.ts prod tsx packages/db/scripts/seed.ts",
    "db:migrate-legacy": "tsx packages/db/scripts/migrate-legacy-owner.ts",
    "db:migrate-legacy:dev": "tsx bin/run-with-env.ts dev tsx packages/db/scripts/migrate-legacy-owner.ts",
    "db:migrate-legacy:prod": "tsx bin/run-with-env.ts prod tsx packages/db/scripts/migrate-legacy-owner.ts",
    "db:migrate-registry-ui-type": "tsx packages/db/scripts/migrate-registry-ui-type.ts",
    "db:migrate-registry-ui-type:dev": "tsx bin/run-with-env.ts dev tsx packages/db/scripts/migrate-registry-ui-type.ts",
    "db:migrate-registry-ui-type:prod": "tsx bin/run-with-env.ts prod tsx packages/db/scripts/migrate-registry-ui-type.ts",
    "db:migrate-oauth-pkce": "tsx packages/db/scripts/migrate-oauth-pkce.ts",
    "db:migrate-oauth-pkce:dev": "tsx bin/run-with-env.ts dev tsx packages/db/scripts/migrate-oauth-pkce.ts",
    "db:migrate-oauth-pkce:prod": "tsx bin/run-with-env.ts prod tsx packages/db/scripts/migrate-oauth-pkce.ts",
    "cozy-thumbnail-worker:dev": "tsx bin/run-with-env.ts dev tsx bin/cozy-thumbnail-worker.ts",
    "cozy-thumbnail-worker:prod": "tsx bin/run-with-env.ts prod tsx bin/cozy-thumbnail-worker.ts",
    "cozy-thumbnail-requeue-all:dev": "tsx bin/run-with-env.ts dev tsx bin/cozy-thumbnail-requeue-all.ts",
    "cozy-thumbnail-requeue-all:prod": "tsx bin/run-with-env.ts prod tsx bin/cozy-thumbnail-requeue-all.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@base-ui/react": "^1.3.0",
    "@better-auth/api-key": "^1.5.0",
    "@cozy/auth-control": "workspace:*",
    "@cozy/auth-runtime": "workspace:*",
    "@cozy/db": "workspace:*",
    "@cozy/extraction": "workspace:*",
    "@cozy/mcp": "workspace:*",
    "@cozy/oauth": "workspace:*",
    "@cozy/platform-core": "workspace:*",
    "@cozy/platform-services": "workspace:*",
    "@cozy/preview": "workspace:*",
    "@cozy/registry-domain": "workspace:*",
    "@cozy/shared": "workspace:*",
    "@cozy/thumbnail": "workspace:*",
    "@cozy/tooling": "workspace:*",
    "@cozy/ui": "workspace:*",
    "@hono/node-server": "1.19.11",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.6",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sparticuz/chromium": "^143.0.4",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "4.12.7",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "playwright-core": "^1.58.2",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^4.8.0",
    "shadcn": "^4.0.8",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.24.0",
    "eslint": "^9",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "turbo": "^2.8.21",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^2.1.9"
  }
}
